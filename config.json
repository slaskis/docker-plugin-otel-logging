{
  "Description": "OpenTelemetry logging plugin for Docker",
  "Documentation": "https://github.com/slaskis/docker-plugin-otel-logging",
  "Entrypoint": ["/usr/bin/docker-plugin-otel-logging"],
  "Interface": {
    "Types": ["docker.logdriver/1.0"],
    "Socket": "otel.sock"
  },
  "Network": {
    "Type": "host"
  },
  "Env": [],
  "propagatedMount": "/run/docker/plugins"
}
